# Agent Skill Builder — environment
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gemini model selection (scripts/gemini-video-analyze.sh) -------------
# Primary -> fallback chain, tried in order. On overload (503) or rate limit
# (429) the script falls through to the next model automatically.
# 2.5-flash is deprecated for new keys. 3.8/3.7 are the strongest but are
# often busy; 3.6/3.5 flash are the reliable workhorses; lite is the last resort.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Single-model override (used only if GEMINI_MODELS is unset). Back-compat.
# GEMINI_MODEL=gemini-3.6-flash

# Reasoning effort for agentic work: minimal | low | medium | high | off
# ("off" disables thinking; "high" = most agentic / deepest reasoning.)
GEMINI_THINKING=high

# Retries per model on overload/rate limit, and seconds between attempts.
GEMINI_ATTEMPTS=3
GEMINI_RETRY_SLEEP=8
