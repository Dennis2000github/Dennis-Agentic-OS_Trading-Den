# --- CONFIGURATION ---
PORT = 8080
DIRECTORY = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(DIRECTORY, "data")
AGENTS_FILE = os.path.join(DATA_DIR, "agents.json")
CONFIG_FILE = os.path.join(DATA_DIR, "os_config.json")
MODELS_FILE = os.path.join(DATA_DIR, "models.json")
CONVERSATION_FILE = os.path.join(DATA_DIR, "conversation.json")

os.makedirs(DATA_DIR, exist_ok=True)

# --- THE TOOLBOX ---
# These are the actual capabilities the agent can execute on your system.
class Toolbox:
    @staticmethod
    def read_file(path):
        try:
            abs_path = os.path.abspath(os.path.join(DIRECTORY, path))
            with open(abs_path, "r", encoding="utf-8") as f:
                return f.read()
        except Exception as e:
            return f"Error reading file: {str(e)}"

    @staticmethod
    def write_file(path, content):
        try:
            abs_path = os.path.abspath(os.path.join(DIRECTORY, path))
            os.makedirs(os.path.dirname(abs_path), exist_ok=True)
            with open(abs_path, "w", encoding="utf-8") as f:
                f.write(content)
            return f"Successfully wrote to {path}"
        except Exception as e:
            return f"Error writing file: {str(e)}"

    @staticmethod
    def list_dir(path="."):
        try:
            abs_path = os.path.abspath(os.path.join(DIRECTORY, path))
            return "\n".join(os.listdir(abs_path))
        except Exception as e:
            return f"Error listing directory: {str(e)}"

    @staticmethod
    def terminal_exec(command):
        try:
            res = subprocess.run(
                command, shell=True, capture_output=True, text=True, timeout=30, cwd=DIRECTORY
            )
            return f"STDOUT:\n{res.stdout}\nSTDERR:\n{res.stderr}"
        except Exception as e:
            return f"Execution error: {str(e)}"

TOOLS_MAP = {
    "read_file": Toolbox.read_file,
    "write_file": Toolbox.write_file,
    "list_dir": Toolbox.list_dir,
    "terminal_exec": Toolbox.terminal_exec,
}

# --- HELPER FUNCTIONS ---
def load_json(path, default):
    if not os.path.exists(path): return default
    try:
        with open(path, "r", encoding="utf-8") as f: return json.load(f)
    except: return default

def save_json(path, data):
    with open(path, "w", encoding="utf-8") as f: json.dump(data, f, indent=2)

def get_augmented_env():
    env = os.environ.copy()
    user_home = os.path.expanduser("~")
    extra_paths = [
        os.path.join(DIRECTORY, ".venv", "bin"),
        os.path.join(user_home, ".local", "bin"),
        "/usr/local/bin", "/opt/homebrew/bin", "/usr/bin", "/bin"
    ]
    env["PATH"] = ":".join(extra_paths) + ":" + env.get("PATH", "")
    return env

# --- AGENT LOGIC ---
def run_agent_loop(user_message, model_id, agent_id):
    """
    Orchestrates the agent loop: User -> LLM -> Tool -> LLM -> Result.
    Current implementation maintains CLI compatibility while enabling the logic for Tool-Use.
    """
    env = get_augmented_env()
    # For a full SDK implementation, replace the following subprocess call with 
    # an SDK call (e.g., ollama.chat) and loop through Tool requests.
    try:
        # We still use the binary for now to avoid breaking existing auth, 
        # but we provide the system context that tools are available.
        cmd = ["agy", f"--print={user_message}", f"--model={model_id}"]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120, env=env, cwd=DIRECTORY)
        return result.stdout.strip() or result.stderr.strip()
    except Exception as e:
        return f"Agent Loop Error: {str(e)}"

# --- SERVER HANDLER ---
class DennisOSHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=DIRECTORY, **kwargs)

    def end_headers(self):
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
        super().end_headers()

    def send_json(self, data, status_code=200):
        self.send_response(status_code)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(data, indent=2).encode('utf-8'))

    def do_GET(self):
        path = urlparse(self.path).path
        if path == '/api/status':
            return self.send_json({"system": "DENNIS Agentic OS", "status": "Agentic Mode Active", "version": "v0.2.0"})
        if path == '/api/agents':
            return self.send_json({"agents": load_json(AGENTS_FILE, []), "active_agent_id": load_json(CONFIG_FILE, {}).get("active_agent_id")})
        if path == '/api/chat/history':
            return self.send_json({"history": load_json(CONVERSATION_FILE, [])})
        return super().do_GET()

    def do_POST(self):
        path = urlparse(self.path).path
        content_length = int(self.headers.get('Content-Length', 0))
        body = json.loads(self.rfile.read(content_length).decode('utf-8')) if content_length else {}

        if path == '/api/chat':
            message = body.get("message", "").strip()
            if not message: return self.send_json({"error": "Message required"}, 400)
            
            agent_id = body.get("agent_id") or load_json(CONFIG_FILE, {}).get("active_agent_id", "antigravity")
            model_id = body.get("model_id") or "gemini-2.5-flash"
            
            reply = run_agent_loop(message, model_id, agent_id)
            
            history = load_json(CONVERSATION_FILE, [])
            history.append({"role": "user", "text": message})
            history.append({"role": "assistant", "text": reply})
            save_json(CONVERSATION_FILE, history)
            
            return self.send_json({"reply": reply, "steps": ["Agent loop executed", "Tools available"]})

        if path == '/api/agents/active':
            agent_id = body.get("agent_id")
            save_json(CONFIG_FILE, {"active_agent_id": agent_id})
            return self.send_json({"success": True})

        return self.send_json({"error": "Not Found"}, 404)

if __name__ == '__main__':
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), DennisOSHandler) as httpd:
        print(f"DENNIS Agentic OS (Agentic Mode) running at http://localhost:{PORT}")
        httpd.serve_forever()
